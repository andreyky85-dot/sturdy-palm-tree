# Copy to .env.local and fill in values.
# Сводка по группам (без вывода секретов): npm run check:env

# OpenAI (без ключа работает локальный шаблонный режим; для продакшена ключ обязателен)
OPENAI_API_KEY=
# Необязательно, по умолчанию gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Stripe — по умолчанию ВЫКЛЮЧЕНО: без BILLING_ENABLED=true не создаются сессии оплаты, даже если ключи заданы.
# Включайте только когда готовы к реальным списаниям и настроен webhook.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database — PostgreSQL (локально: Neon/Supabase/Docker; на Vercel: Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Только экстренный случай на Vercel, если DATABASE_URL недоступна на Build: см. docs/VERCEL_DATABASE_URL.md
# PRISMA_BUILD_SKIP_MIGRATE=1

# Rate limit по IP (Upstash Redis). Без них rate limit отключён.
# Upstash: console.upstash.com или Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Только локально / CI: E2E Playwright без Google OAuth ---
# Не задавать на Vercel (при VERCEL=1 приложение упадёт при старте, если включить флаг).
# ENABLE_E2E_CREDENTIALS=true
# E2E_AUTH_EMAIL=e2e@example.local
# E2E_AUTH_PASSWORD=минимум_8_символов_секрет
