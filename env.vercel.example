# Переменные для Vercel (Settings → Environment Variables)
# Скопируйте имена и подставьте свои значения в дашборде Vercel.
# Сборка на Vercel: vercel.json → npm run build:vercel (prisma migrate deploy + next build).
# DATABASE_URL должна быть задана до успешной сборки с миграциями.
# После первого деплоя замените ваш-домен.vercel.app на реальный URL проекта.

DATABASE_URL=
# ↑ Часто подставляется автоматически при подключении Vercel Postgres к проекту

OPENAI_API_KEY=

# Платежи: оставьте BILLING_ENABLED не заданным или false, пока не готовы к Stripe в проде.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

NEXTAUTH_URL=https://ваш-домен.vercel.app
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://ваш-домен.vercel.app

# Rate limit по IP (Upstash Redis или Vercel KV). Без значений — лимит отключён.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
